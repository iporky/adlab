{
  "swagger": "2.0",
  "consumes": [
    "application/json",
    "application/x-www-form-urlencoded"
  ],
  "produces": [
    "application/json"
  ],
  "info": {
    "title": "adsV2",
    "description": "This API provides the ability to read the datasources",
    "version": "1.0"
  },
  "basePath": "/v2",
  "schemes": [
    "http",
    "https"
  ],
  "responses": {
    "BadRequest": {
      "description": "The request was invalid. For example, the value of the initial parameter was invalid",
      "schema": {
        "type": "string"
      }
    },
    "NotFound": {
      "description": "The resource was not found",
      "schema": {
        "type": "string"
      }
    }
  },
  "paths": {
    "/campaigns/{campaignId}/personaConfig/{personaConfigId}/datasources": {
      "post": {
        "summary": "Generate persona data from combinations",
        "operationId": "createPersonaData",
        "parameters": [
          {
            "$ref": "#/parameters/clientId"
          },
          {
            "$ref": "#/parameters/accountId"
          },
          {
            "$ref": "#/parameters/userId"
          },
          {
            "name": "body",
            "in": "body",
            "description": "The platform and list of advertisements to post",
            "required": true,
            "schema": {
              "type": "object"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The campaign was created successfully."
          },
          "400": {
            "$ref": "#/responses/BadRequest"
          }
        }
      },
      "get": {
        "summary": "Retrieve all data sources for a persona config.",
        "operationId": "getDataSources",
        "parameters": [
          {
            "$ref": "#/parameters/clientId"
          },
          {
            "$ref": "#/parameters/accountId"
          },
          {
            "name": "offset",
            "in": "query",
            "description": "Pagination offset",
            "required": false,
            "type": "integer",
            "default": 0,
            "minimum": 0
          },
          {
            "name": "count",
            "in": "query",
            "description": "Number of records to return",
            "required": false,
            "type": "integer",
            "default": 10,
            "minimum": 1
          }
        ],
        "responses": {
          "200": {
            "description": "A list of data sources for the campaign and persona config."
          },
          "400": {
            "$ref": "#/responses/BadRequest"
          },
          "404": {
            "$ref": "#/responses/NotFound"
          }
        }
      }
    }
  },
  "definitions": {
    "ErrorResponse": {
      "properties": {
        "code": {
          "description": "A status code",
          "type": "string"
        },
        "reason": {
          "description": "A descriptive message",
          "type": "string"
        }
      }
    }
  }
}