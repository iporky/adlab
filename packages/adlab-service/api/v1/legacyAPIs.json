              "type": "object"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The ad was updated"
          },
          "400": {
            "$ref": "#/responses/BadRequest"
          },
          "404": {
            "$ref": "#/responses/NotFound"
          }
        }
      },
      "delete": {
        "summary": "Deletes the ad",
        "operationId": "deleteAdById",
        "parameters": [
          {
            "$ref": "#/parameters/clientId"
          },
          {
            "$ref": "#/parameters/accountId"
          },
          {
            "$ref": "#/parameters/userId"
          },
          {
            "name": "adId",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "The ID of the ad to delete"
          }
        ],
        "responses": {
          "200": {
            "description": "The ad was deleted"
          },
          "400": {
            "$ref": "#/responses/BadRequest"
          },
          "404": {
            "$ref": "#/responses/NotFound"
          }
        }
      }
    }
  },
  "definitions": {
    "savedFormData": {
      "type": "object",
      "properties": {
        "_id": {
          "type": "string",
          "description": "The ID of the form data"
        },
        "data": {
          "type": "string",
          "description": "The form data for the campaign"
        }
      }
    },
    "ErrorResponse": {
      "properties": {
        "code": {
          "description": "A status code",
          "type": "string"
        },
        "reason": {
          "description": "A descriptive message",
          "type": "string"
        }
      }
    }
  }
}
