{
  "swagger": "2.0",
  "consumes": ["application/json", "application/x-www-form-urlencoded"],
  "produces": ["application/json"],
  "info": {
    "title": "adsPreview",
    "description": "This API provides the ability to preview ad creatives",
    "version": "1.0"
  },
  "basePath": "/v1",
  "schemes": ["http", "https"],
  "responses": {
    "BadRequest": {
      "description": "The request was invalid. For example, the value of the initial parameter was invalid",
      "schema": {
        "type": "string"
      }
    },
    "NotFound": {
      "description": "The resource was not found",
      "schema": {
        "type": "string"
      }
    }
  },
  "paths": {
    "/preview": {
      "post": {
        "summary": "Preview ad creative for the given creative id",
        "operationId": "getPreviewForCreative",
        "parameters": [
          {
            "$ref": "#/parameters/clientId"
          },
          {
            "$ref": "#/parameters/accountId"
          },
          {
            "$ref": "#/parameters/platformInQuery"
          },
          {
            "name": "creativeId",
            "in": "query",
            "description": "The id of the ad creative",
            "required": false,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "creative preview for ad"
          },
          "400": {
            "$ref": "#/responses/BadRequest"
          },
          "404": {
            "$ref": "#/responses/NotFound"
          }
        }
      }
    }
  },
  "definitions": {
    "ErrorResponse": {
      "properties": {
        "code": {
          "description": "A status code",
          "type": "string"
        },
        "reason": {
          "description": "A descriptive message",
          "type": "string"
        }
      }
    }
  }
}
