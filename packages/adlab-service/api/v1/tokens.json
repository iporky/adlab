{
  "swagger": "2.0",
  "consumes": ["application/json"],
  "produces": ["application/json"],
  "info": {
    "title": "Token Configuration API",
    "description": "API for managing token configurations",
    "version": "1.0"
  },
  "basePath": "/v1",
  "schemes": ["http", "https"],
  "paths": {
    "/tokens": {
      "post": {
        "summary": "Insert a new token configuration",
        "operationId": "insertTokenConfig",
        "parameters": [
          {
            "$ref": "#/parameters/serviceApiKey"
          },
          {
            "$ref": "#/parameters/userId"
          },
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/TokenConfig"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Token configuration created successfully"
          },
          "400": {
            "description": "Invalid request parameters"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      },
      "get": {
        "summary": "Fetch all token configurations",
        "operationId": "fetchAllTokenConfigs",
        "parameters": [
          {
            "$ref": "#/parameters/serviceApiKey"
          }
        ],
        "responses": {
          "200": {
            "description": "List of token configurations",
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/TokenConfig"
              }
            }
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/tokens/{platform}": {
      "get": {
        "summary": "Fetch a token configuration by platform",
        "operationId": "fetchTokenConfig",
        "parameters": [
          {
            "$ref": "#/parameters/serviceApiKey"
          },
          {
            "$ref": "#/parameters/platformInPath"
          }
        ],
        "responses": {
          "200": {
            "description": "Token configuration",
            "schema": {
              "$ref": "#/definitions/TokenConfig"
            }
          },
          "404": {
            "description": "Token configuration not found"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      },
      "put": {
        "summary": "Update a token configuration by platform",
        "operationId": "updateTokenConfig",
        "parameters": [
          {
            "$ref": "#/parameters/serviceApiKey"
          },
          {
            "$ref": "#/parameters/userId"
          },
          {
            "$ref": "#/parameters/platformInPath"
          },
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/TokenConfig"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Token configuration updated successfully"
          },
          "400": {
            "description": "Invalid request parameters"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      },
      "delete": {
        "summary": "Delete a token configuration by platform",
        "operationId": "deleteTokenConfig",
        "parameters": [
          {
            "$ref": "#/parameters/serviceApiKey"
          },
          {
            "$ref": "#/parameters/userId"
          },
          {
            "$ref": "#/parameters/platformInPath"
          }
        ],
        "responses": {
          "204": {
            "description": "Token configuration deleted successfully"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    }
  },
  "definitions": {
    "TokenConfig": {
      "type": "object",
      "properties": {
        "platform": {
          "$ref": "#/definitions/PlatformEnum",
          "description": "The platform for which the token configuration is defined"
        },
        "xTFSAccountId": {
          "type": "string",
          "description": "The TFS account ID"
        },
        "adAccountId": {
          "type": "string",
          "description": "The ad account ID"
        },
        "tokenUrl": {
          "type": "string",
          "description": "The token URL"
        },
        "apiBaseUrl": {
          "type": "string",
          "description": "The API base URL"
        },
        "bypassJoiSchemaValidation": {
          "type": "boolean",
          "description": "Flag to bypass Joi schema validation"
        },
        "apps": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/App"
          }
        }
      },
      "required": ["platform", "xTFSAccountId", "adAccountId", "apiBaseUrl"]
    },
    "App": {
      "type": "object",
      "properties": {
        "clientId": {
          "type": "string",
          "description": "The client ID"
        },
        "clientSecret": {
          "type": "string",
          "description": "The client secret"
        },
        "redirectUri": {
          "type": "string",
          "description": "The redirect URI"
        },
        "authorizationCode": {
          "type": "string",
          "description": "The authorization code"
        },
        "refreshToken": {
          "type": "string",
          "description": "The refresh token"
        },
        "accessToken": {
          "type": "string",
          "description": "The access token"
        },
        "app_name": {
          "type": "string",
          "description": "The app name"
        },
        "identityId": {
          "type": "string",
          "description": "The identity ID"
        }
      },
      "required": ["clientId", "clientSecret"]
    }
  }
}
