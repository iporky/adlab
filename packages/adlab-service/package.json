{
  "name": "adlab-service",
  "description": "Node.js based service for adlab",
  "version": "1.0.0",
  "author": "[24]7 ai Inc.",
  "readme": "See README.md",
  "readmeFilename": "README.md",
  "repository": {
    "type": "git",
    "url": "https://github.com/iporky/adlab.git"
  },
  "main": "./lib/factory.js",
  "scripts": {
    "build": "pnpm run lint && pnpm run test",
    "clean": "sh scripts/clean.sh",
    "coverage": "jest . --coverage",
    "debug": "sh scripts/debug.sh",
    "force-resolutions": "npx npm-force-resolutions@0.0.3",
    "format": "eslint . --fix",
    "prof": "sh scripts/prof.sh",
    "start": "sh scripts/start.sh",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "zip": "zip.sh",
    "migrate-mongo": "node migrations",
    "onboard:db": "pnpm run migrate-mongo up",
    "deboard:db": "pnpm run migrate-mongo down"
  },
  "dependencies": {
    "@okta/jwt-verifier": "3.2.2",
    "@tfs/node-assert": "0.0.9",
    "@tfs/node-baseobject": "0.0.3",
    "@tfs/node-config": "0.0.9",
    "@tfs/node-jstoxmlstream": "0.0.6",
    "@tfs/node-log4js-json-appender": "0.4.2",
    "@tfs/node-obslog": "0.2.4",
    "@tfs/node-provhandler": "0.2.5",
    "@tfs/node-request-summary": "0.0.3",
    "@tfs/node-service-correlators": "0.2.2",
    "@tfs/node-service-errors": "0.1.3",
    "@tfs/node-sessionlogger": "0.0.7",
    "@tfs/node-uncaught": "0.0.4",
    "@tfs/node-weblinks": "0.0.6",
    "@tfs/swagger-tools-wrapper": "0.3.1",
    "adlab-adapters": "workspace:*",
    "adlab-shared": "workspace:*",
    "axios": "1.7.4",
    "body-parser": "1.20.3",
    "compression": "1.7.4",
    "cors": "2.8.5",
    "express": "4.18.2",
    "extend": "3.0.2",
    "fluent-ffmpeg": "2.1.3",
    "lodash": "4.17.21",
    "log4js": "6.7.1",
    "lru-cache": "11.0.0",
    "mongoose": "8.7.1",
    "multer": "2.0.2",
    "nopt": "4.0.3",
    "sharp": "0.33.5",
    "xlsx": "0.18.5"
  },
  "devDependencies": {
    "@babel/core": "7.24.8",
    "@babel/plugin-syntax-import-attributes": "7.25.6",
    "@babel/preset-env": "7.24.8",
    "@jest/globals": "29.7.0",
    "@tfs/eslint-config-247ai-node-base": "1.1.1",
    "babel-jest": "29.7.0",
    "eslint": "8.57.0",
    "eslint-plugin-import": "2.25.2",
    "eslint-plugin-jsdoc": "46.4.2",
    "eslint-plugin-node": "11.1.0",
    "eslint-plugin-require-jsdoc": "1.0.4",
    "fancy-log": "1.3.3",
    "jest": "29.7.0",
    "mongodb-memory-server": "10.0.0",
    "nodemon": "3.1.4",
    "should": "13.2.3",
    "supertest": "4.0.2"
  },
  "engines": {
    "node": ">= 20.17.0"
  },
  "nodemonConfig": {
    "ignore": [
      "**/test/**",
      "**/config/**"
    ]
  },
  "type": "module"
}
