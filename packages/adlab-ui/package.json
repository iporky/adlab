{
  "name": "adlab-ui",
  "description": "A React based UI interface for AdLab",
  "version": "1.0.0",
  "keywords": [
    "react",
    "redux-toolkit",
    "rtk-query",
    "@swc/core",
    "rsbuild",
    "sass",
    "stylelint",
    "eslint",
    "jest",
    "playwright",
    "msw"
  ],
  "scripts": {
    "build": "rsbuild build",
    "dev": "rsbuild dev --open",
    "dev:docker": "rsbuild dev --env-mode docker",
    "dev:msw": "rsbuild dev --env-mode test",
    "lint:code": "npx eslint .",
    "lint:code-fix": "npx eslint . --fix",
    "lint:css": "npx stylelint src/**/*.{js,jsx,scss}",
    "lint:css-fix": "npx stylelint src/**/*.{js,jsx,scss} --fix",
    "pretty:check": "npx prettier . --check",
    "pretty:fix": "npx prettier . --write",
    "lint": "pnpm lint:code && pnpm lint:css && pnpm pretty:check",
    "lint:fix": "pnpm lint:code-fix && pnpm lint:css-fix && pnpm pretty:fix",
    "preview": "rsbuild preview",
    "preview:docker": "rsbuild build && rsbuild preview --env-mode stage",
    "test": "npx jest",
    "test:update": "npx jest -- -u",
    "coverage:show": "lcov-summary coverage/lcov.info",
    "e2e": "pnpm exec playwright test --config=playwright.config.js",
    "e2e:msw": "cross-env PUBLIC_ENABLE_MSW=true pnpm exec playwright test --config=playwright.config.js"
  },
  "dependencies": {
    "@emotion/core": "11.0.0",
    "@emotion/react": "11.11.4",
    "@emotion/styled": "11.11.5",
    "@okta/okta-auth-js": "7.7.0",
    "@okta/okta-react": "6.9.0",
    "@reduxjs/toolkit": "2.2.6",
    "@tfs/icons": "10.0.2",
    "@tfs/ui-components-next": "10.0.4",
    "adlab-shared": "workspace:*",
    "exceljs": "4.4.0",
    "isomorphic-fetch": "3.0.0",
    "lodash": "4.17.21",
    "node-polyglot": "2.6.0",
    "pako": "2.1.0",
    "papaparse": "5.4.1",
    "prop-types": "15.8.1",
    "react": "18.3.1",
    "@fluentui/react-components": "9.47.1",
    "react-dom": "18.3.1",
    "react-drag-drop-files": "2.3.10",
    "react-redux": "9.1.2",
    "react-router-dom": "6.24.1",
    "web-vitals": "4.2.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.1.0",
    "@eslint/js": "9.6.0",
    "@playwright/test": "1.45.1",
    "@rsbuild/core": "1.0.1-beta.1",
    "@rsbuild/plugin-basic-ssl": "1.1.1",
    "@rsbuild/plugin-react": "1.0.1-beta.1",
    "@rsbuild/plugin-sass": "1.0.1-beta.3",
    "@stylelint/postcss-css-in-js": "0.38.0",
    "@swc/core": "1.7.0",
    "@swc/jest": "0.2.36",
    "@testing-library/jest-dom": "6.4.6",
    "@testing-library/react": "16.0.0",
    "@testing-library/react-hooks": "8.0.1",
    "@testing-library/user-event": "14.5.2",
    "camelcase": "8.0.0",
    "cross-env": "7.0.3",
    "eslint": "8.55.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-import": "2.29.1",
    "eslint-plugin-jest": "28.6.0",
    "eslint-plugin-jsx-a11y": "6.9.0",
    "eslint-plugin-react": "7.34.3",
    "eslint-plugin-react-hooks": "4.6.2",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "globals": "15.8.0",
    "husky": "9.0.11",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "jest-extended": "4.0.2",
    "jest-watch-typeahead": "2.2.2",
    "lcov-summary": "1.0.1",
    "lint-staged": "15.2.7",
    "msw": "2.3.1",
    "postcss": "8.4.39",
    "postcss-syntax": "0.36.2",
    "prettier": "3.3.2",
    "resize-observer-polyfill": "1.5.1",
    "stylelint": "16.7.0",
    "stylelint-config-recommended": "14.0.1",
    "stylelint-config-standard-scss": "13.1.0",
    "stylelint-define-config": "1.5.0"
  },
  "lint-staged": {
    "*.{js,cjs,mjs,jsx}": [
      "eslint --fix",
      "stylelint --fix",
      "prettier --write"
    ],
    "*.{scss,css}": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "type": "module",
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
