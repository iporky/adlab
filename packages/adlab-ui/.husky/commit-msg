#!/bin/sh

COMMIT_MSG_FILE=$1
COMMIT_MSG=$(cat $COMMIT_MSG_FILE)

PATTERN="^(feature|bugfix|task|hotfix|revert)\/([A-Z0-9]+)-([0-9]+)\/(.+)$"

if ! [[ $COMMIT_MSG =~ $PATTERN ]]; then
  echo "ERROR: Commit message does not follow the pattern: ^(feature|bugfix|task|hotfix|revert)/([A-Z0-9]+)-([0-9]+)/(.+)$"
  exit 1
fi
