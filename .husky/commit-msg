#!/bin/sh

COMMIT_MSG_FILE=$1
COMMIT_MSG=$(cat $COMMIT_MSG_FILE)

shopt -s nocasematch
CONVENTIONAL_PATTERN="^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-zA-Z0-9_\-\/.]+\))?: (.+)$"
TICKET_PATTERN="^(feature|bugfix|task|hotfix|revert)\/([A-Z0-9]+)-([0-9]+)\/(.+)$"

if ! [[ $COMMIT_MSG =~ $CONVENTIONAL_PATTERN ]] && ! [[ $COMMIT_MSG =~ $TICKET_PATTERN ]]; then
  echo "ERROR: Commit message must follow Conventional Commits (e.g. 'feat: description') or ticket pattern (e.g. 'feature/ABC-123/description')"
  exit 1
fi

shopt -u nocasematch
